<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".ui.UserActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="40dp">

        <TextView
            android:id="@+id/textWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/login_text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonHouse"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:text="@string/house_button"
            android:textColor="@color/login_on_primary"
            android:textSize="16sp"
            app:backgroundTint="@color/login_primary"
            app:cornerRadius="16dp"
            app:elevation="0dp" />

        <!-- "Expenses" button: opens ExpenseActivity with the expenses of the user's house -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonExpenses"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/expenses_button"
            android:textColor="@color/login_on_primary"
            android:textSize="16sp"
            app:backgroundTint="@color/login_primary"
            app:cornerRadius="16dp"
            app:elevation="0dp" />

        <!-- User information will be added here later -->

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
