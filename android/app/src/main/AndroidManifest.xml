<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" >


    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Android 17+: necesario para conectar con direcciones de red local (backend en 10.0.2.2 / LAN) -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK"/>
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HouseMate" >
        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.HouseMate"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.UserActivity"
            android:exported="false"
            android:theme="@style/Theme.HouseMate" />
        <activity
            android:name=".ui.HouseActivity"
            android:exported="false"
            android:theme="@style/Theme.HouseMate" />
        <activity
            android:name=".ui.ExpenseActivity"
            android:exported="false"
            android:theme="@style/Theme.HouseMate" />

    </application>

</manifest>